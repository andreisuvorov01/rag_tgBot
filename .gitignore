# секреты и локальная конфигурация
.env

# окружение, кэши моделей, временные файлы
venv/
hf-cache/
rag-tmp/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
*.orig
*.rej

# данные пользователя: БД, оригиналы загруженных документов, демо-прогоны
data/*.db
data/*.db-*
data/uploads/
data/demo/
# рабочие артефакты, которые пересобираются из БД: журнал расхода токенов,
# Excel-журнал личных расходов и сгенерированные отчёты по ним (/ledger, /report),
# а также разовые отладочные файлы
data/llm_usage.jsonl
data/*.xlsx
!data/.gitkeep
