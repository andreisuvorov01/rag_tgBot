# ============ Telegram ============
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID пользователей с доступом через запятую (проверить: @userinfobot)
ALLOWED_USER_IDS=
# Код регистрации для входа новых пользователей, если whitelist не задан
REG_CODE=change-me-please

# ============ Хранилище ============
# Продакшен (docker compose up postgres):
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# Разработка (по умолчанию, векторный поиск brute-force):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATA_DIR=data
MAX_FILE_MB=20

# ============ LLM: ГЕНЕРАЦИЯ ОТВЕТОВ ============
# llm_provider: openai_compatible | gigachat | anthropic | mock (offline-демо без сети)
LLM_PROVIDER=openai_compatible

# Вариант A — OpenAI-совместимый endpoint (OpenAI / DeepSeek / OpenRouter / YandexGPT / vLLM / Ollama).
#   ПОЛНОСТЬЮ ЛОКАЛЬНО (приватность, ноль расходов на токены):
#     1) установить Ollama (https://ollama.com)
#     2) скачать модель:  ollama pull qwen2.5:1.5b-instruct-q4_K_M   (~986 МБ)
#     3) LLM_API_BASE=http://localhost:11434/v1  LLM_API_KEY=ollama
#        LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M  LLM_TIMEOUT_S=180
#     Больше ОЗУ (12 ГБ+): qwen2.5:3b-instruct-q4_K_M (~2 ГБ) — заметно умнее.
#   ВНЕШНИЙ API (платно, но качество и скорость выше — см. docs/deploy.md):
#     OpenAI:      LLM_API_BASE=https://api.openai.com/v1         LLM_MODEL=gpt-4.1-mini
#     DeepSeek:    LLM_API_BASE=https://api.deepseek.com/v1       LLM_MODEL=deepseek-chat
#     OpenRouter:  LLM_API_BASE=https://openrouter.ai/api/v1      LLM_MODEL=anthropic/claude-sonnet-4.5
#     YandexGPT:   LLM_API_BASE=https://llm.api.cloud.yandex.net/v1  LLM_MODEL=gpt://<folder>/yandexgpt/latest
#   Свой GPU-сервер с vLLM: LLM_API_BASE=http://gpu-host:8000/v1, LLM_API_KEY=EMPTY
#   База указывается ВКЛЮЧАЯ /v1, но БЕЗ /chat/completions — путь клиент дописывает сам.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Режим рассуждений провайдера. DeepSeek включает его ПО УМОЛЧАНИЮ: «мысли» идут
# в completion_tokens (оплачиваются) и съедают max_tokens — при жёстком лимите
# ответ приходит пустым. Замер (scripts/thinking_bench, 3 прогона golden-набора):
# рассуждения НЕ улучшили ответы (6,0 против 6,7 верных), но стоили в 1,3–1,5
# раза дороже и отвечали почти вдвое медленнее. Поэтому disabled.
# default — ничего не отправлять (для провайдеров без такого параметра).
# low / high / max — включить рассуждения с заданным усилием.
LLM_THINKING=disabled
# Рассуждения только для части задач: "compose" — ответы пользователю;
# служебные шаги (классификация, реранкинг, SQL) останутся без них.
LLM_THINKING_TASKS=

# --- ЭКОНОМИЯ ТОКЕНОВ (актуально только для внешнего платного API) ---
# Дешёвая модель для шагов, которые НЕ формулируют ответ: классификация,
# реранкинг, генерация SQL. Эти вызовы происходят чаще композитора, поэтому
# здесь самая крупная экономия. Композитор всегда работает на LLM_MODEL.
# Пример: LLM_MODEL=gpt-4.1  +  LLM_MODEL_SMALL=gpt-4.1-nano
LLM_MODEL_SMALL=
LLM_MODEL_SMALL_TASKS=classify,rerank,sql
# Повторы при 429/5xx и сетевых сбоях: один рейт-лимит больше не отбрасывает
# ответ на шаблон (1, 2, 4 с; учитывается заголовок Retry-After)
LLM_RETRIES=3
LLM_RETRY_BASE_S=1.0
# Журнал расхода токенов (JSONL); пусто -> {DATA_DIR}/llm_usage.jsonl
LLM_USAGE_LOG=
# Цены за 1 млн токенов для оценки расхода в /usage и scripts/llm_usage.py:
#   "модель=вход/выход,..."  Например:
#   DeepSeek (¥):    LLM_PRICES="deepseek-flash=1/4"
#   OpenAI ($):      LLM_PRICES="gpt-4.1-mini=0.40/1.60,gpt-4.1-nano=0.10/0.40"
LLM_PRICES=
# Баланс ключа в тех же деньгах, что и LLM_PRICES (33 = 33 ¥ у DeepSeek).
# Нужен для строки «осталось / на сколько ещё хватит» в /usage.
# Расчёт числа вопросов под ваш баланс: python -m scripts.balance_forecast
LLM_BALANCE=0
# Пауза после ответа «баланс исчерпан» (HTTP 402), секунды: пока не истекла,
# в API не ходим — ответы собираются шаблоном, пользователь получает
# предупреждение. 0 — пробовать каждый раз (например, сразу после пополнения).
LLM_BALANCE_RETRY_S=300
# Сколько ответов модели помнить, чтобы повторный вопрос не оплачивался дважды
# (шаблонные ответы кода не кэшируются — они и так бесплатны). 0 — выключить.
ANSWER_CACHE_SIZE=64
# Лимиты токенов на служебные шаги: JSON-ответы короткие
CLASSIFIER_MAX_TOKENS=120
SQL_MAX_TOKENS=400
RERANK_MAX_TOKENS=600
# Сколько кандидатов и символов фрагмента уходит в LLM-реранкер (самая
# «токеноголодная» ступень: в промпт попадают фрагменты документов)
RERANK_MAX_ITEMS=8
RERANK_SNIPPET_CHARS=200
# Бюджет промпта ответа: сколько фрагментов документов и символов каждого
# попадает в промпт композитора. Это самый крупный блок входа — уменьшение
# даёт прямую экономию, слишком сильное режет качество вывода по документам.
COMPOSER_CONTEXT_ITEMS=5
COMPOSER_CONTEXT_CHARS=200
# Сколько строк истории (ряды помесячных данных) уходит в промпт
COMPOSER_HISTORY_ROWS=24

# Вариант C — Anthropic (нативный протокол + prompt caching):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-5
# PROMPT_CACHE=true   (cache_control на системном промпте и блоке данных)

# Вариант B — GigaChat (собственный протокол, ключи из Sber AI Studio):
# LLM_PROVIDER=gigachat
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS  (или GIGACHAT_API_B2B / GIGACHAT_API_CORP)
# GIGACHAT_INSECURE=true  (у Сбера самоподписанные сертификаты)

# ============ Эмбеддинги: ЛОКАЛЬНО (ноль расходов на токены) ============
# embeddings_provider: sentence_transformers | api (OpenAI-совместимый) | hash (dev/тест)
# Продакшен: sentence_transformers (модель скачается при первом запуске).
# Векторизация — самая объёмная операция по тексту: каждый загруженный документ
# превращается в десятки фрагментов. Через внешний API это заметные деньги,
# локально — только время CPU. Поэтому по умолчанию она ЛОКАЛЬНАЯ.
# ВНИМАНИЕ: при EMBEDDINGS_PROVIDER=api и внешнем хосте тексты документов уходят
# наружу. AnonymizingLLM покрывает чат-вызовы, а embeddings маскируются тем же
# ANONYMIZE_PROMPTS=true (см. app/embeddings.py) — с true маскирование включено.
# Быстрый старт: hash (работает без нейросети, качество поиска ниже)
EMBEDDINGS_PROVIDER=sentence_transformers
EMBEDDINGS_DIM=384
# Внешний embeddings-endpoint запрещён: векторизация документов — самая
# объёмная операция по тексту, через платный API это прямые деньги и вынос
# текстов наружу. Запуск с внешним API отвергается, пока не выставлено
# REQUIRE_LOCAL_EMBEDDINGS=false (осознанное исключение, тогда обязателен
# ANONYMIZE_PROMPTS=true).
REQUIRE_LOCAL_EMBEDDINGS=true
# Варианты модели (размерность EMBEDDINGS_DIM должна совпадать с моделью!):
#   intfloat/multilingual-e5-small (~0,5 ГБ, dim 384) — оптимум для 6 ГБ ОЗУ:
#     в 5–7 раз быстрее bge-m3 на CPU, русский ищет хорошо
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (~0,5 ГБ, dim 384)
#     — почти тот же размер, чуть слабее e5-small
#   intfloat/multilingual-e5-large (~2,2 ГБ, dim 1024) — для машин с 12+ ГБ ОЗУ
#   BAAI/bge-m3 (~2,3 ГБ, dim 1024) — максимум качества для русского,
#     но на CPU ~0,5 с на фрагмент: отчёт из 10 показателей читается ~5 с
# После смены модели выполните: python -m scripts.reindex
# Видеокарта NVIDIA ускоряет векторизацию в ~10 раз (bge-m3: 5 с -> 0,5 с на отчёт).
# Нужна CUDA-сборка torch (setup_venv.bat ставит её сама, если найдёт nvidia-smi):
#   pip install --index-url https://download.pytorch.org/whl/cu126 torch
# EMBEDDINGS_DEVICE=auto   # auto | cpu | cuda
EMBEDDINGS_LOCAL_MODEL=intfloat/multilingual-e5-small

# ============ Векторный бэкенд ============
# auto (по умолчанию: pgvector на PostgreSQL / перебор на SQLite) | qdrant
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ============ OCR сканов ============
# Локальный вариант: установить Tesseract (rus+eng) + pip install pytesseract — данные не покидают сервер.
# Резервный вариант (по умолчанию выключен): нераспознанные сканы уходят в vision-модель
# внешнего LLM API — ВНИМАНИЕ, изображение документа передаётся наружу!
OCR_VLM_ENABLED=false
# OCR_VLM_MODEL=gpt-4o-mini   # пусто -> берётся LLM_MODEL

# ============ Reranking и агент-верификатор ============
# Перез ранжирование после гибридного поиска:
#   llm — модель оценивает релевантность фрагментов (с внешним API — лучший
#     прирост точности; обслуживается дешёвой моделью, см. LLM_MODEL_SMALL)
#   crossencoder — локальный кросс-энкодер (pip install sentence-transformers):
#     ноль расходов на токены, но модель в ОЗУ
#   heuristic — быстро и офлайн, без модели (для локальной LLM на CPU)
#   none — только RRF
#   auto — heuristic при LLM_PROVIDER=mock, иначе llm
RERANKER=heuristic
# RERANK_MODEL=BAAI/bge-reranker-base   # для crossencoder
# Агент-верификатор: числа в ответе LLM сверяются с данными (с учётом единиц и
# периода); при расхождении — повтор генерации с замечанием, затем шаблон.
# ВНИМАНИЕ: каждый повтор — это ещё один оплаченный вызов композитора.
VERIFY_ANSWERS=true
# Разрешать производные числа в прогнозе, составе, сравнении и ранжировании:
# там модель обязана считать разности, суммы статей и проценты роста сама
# («прогноз на 9,8% выше факта», «две статьи вместе — 90% расходов»).
# Производные считаются точно из данных, поэтому выдуманные суммы и доли
# по-прежнему отклоняются. false — строгая проверка только по числам из ДАННЫХ
# (корректные ответы с расчётами будут чаще уходить в шаблон).
VERIFY_ALLOW_DERIVED=true
ANSWER_RETRIES=2

# ============ Скорость и объём ответа ============
# Кого пускать к формулировке ответа:
#   auto — то, что код уже посчитал и сверстал (факт, сравнение, состав,
#     прогноз, план/факт), отдаётся шаблоном за доли секунды: ноль токенов
#   llm — пересказывать моделью всегда (лучше текст, но платно на каждый вопрос)
#   template — никогда (полностью офлайн, ноль расходов)
COMPOSE_MODE=auto
# Определение намерения вопроса: false — правилами (бесплатно; правила всё
# равно перекрывают вердикт модели для compare/rank/breakdown/forecast),
# true — спрашивать LLM (каждый вопрос = +1 оплаченный вызов)
CLASSIFY_WITH_LLM=false
# Максимум токенов на ответ модели: это прямая верхняя граница стоимости ответа
COMPOSER_MAX_TOKENS=200

# ============ Безопасность ============
# Маскировать названия организаций/ИНН/реквизиты в промптах перед отправкой в LLM API
ANONYMIZE_PROMPTS=true
